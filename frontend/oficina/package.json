{
  "name": "hack30x-oficina",
  "version": "0.1.0",
  "private": true,
  "description": "Oficina de agentes de HACK 30X (solo lectura) con intermediario de servidor hacia DETECTAR.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "configurar": "node scripts/local.mjs configurar",
    "dev": "node scripts/local.mjs oficina dev",
    "build": "next build",
    "start": "node scripts/local.mjs oficina start",
    "backend": "node scripts/local.mjs backend",
    "tendencias:actualizar": "node scripts/tendencias-reales.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar:bundle": "node scripts/verificar-bundle.mjs",
    "verificar:visual": "node scripts/verificar-visual.mjs",
    "demo:preparar": "node scripts/demo-simulada.mjs preparar",
    "demo:servir": "node scripts/demo-simulada.mjs servir",
    "demo:verificar": "node scripts/demo-simulada.mjs servir --verificar",
    "demo:limpiar": "node scripts/demo-simulada.mjs limpiar"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
