# Oficina de agentes (E13). Copiar a .env.local y completar. NUNCA versionar valores reales.
# Ninguna variable lleva el prefijo NEXT_PUBLIC_: todas se leen solo en el servidor.

# URL base del backend compartido (sin barra final ni credenciales).
OFICINA_DETECTAR_URL=http://127.0.0.1:8000

# Token administrativo de DETECTAR. Solo lo usa el intermediario del servidor.
DETECTAR_ADMIN_TOKEN=

# Tiempo máximo de espera por solicitud al backend, en milisegundos (1000-30000).
OFICINA_DETECTAR_TIMEOUT_MS=8000
