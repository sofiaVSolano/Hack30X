# Variables de entorno del módulo CREAR (HACK 30X). Todas son opcionales.
# Copiar los valores necesarios al entorno local. No guardar secretos en este archivo.

# Archivo SQLite de las propuestas. Si se deja sin definir:
#   - con DETECTAR_DB_PATH definida: crear.db en la misma carpeta (así la demostración guarda
#     sus propuestas en su carpeta temporal y se borran con ella);
#   - sin DETECTAR_DB_PATH: %LOCALAPPDATA%\hack30x\crear\crear.db (Windows) o
#     ~/.local/share/hack30x/crear/crear.db (Linux/macOS).
# CREAR_DB_PATH=C:\datos\hack30x\crear.db

# Motor de generación de propuestas:
#   auto        -> Claude si hay una credencial de Anthropic en el entorno; si no, plantillas (por defecto)
#   plantillas  -> siempre el motor determinista, sin red ni credenciales
#   claude      -> siempre Claude (si falla, se usan plantillas y la propuesta lo indica)
CREAR_MOTOR=auto

# Modelo y esfuerzo de razonamiento de Claude
CREAR_MODELO=claude-opus-5-5
CREAR_ESFUERZO=medium
CREAR_CLAUDE_TIMEOUT_SECONDS=90
CREAR_CLAUDE_MAX_RETRIES=1

# La credencial de Claude NO es una variable de CREAR: el SDK oficial la lee de
# ANTHROPIC_API_KEY (o de un perfil de «ant auth login»). Definirla solo en la sesión:
#   PowerShell:  $env:ANTHROPIC_API_KEY = "..."
#   bash/zsh:    export ANTHROPIC_API_KEY=...
# Nunca en un archivo versionado ni dentro de OneDrive.
