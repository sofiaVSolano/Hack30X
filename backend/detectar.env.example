# Variables de entorno del módulo DETECTAR (HACK 30X).
# Copiar los valores necesarios al entorno local. No guardar secretos en este archivo.
# Las variables de fuentes, base de datos y seguridad se agregarán en entregas posteriores.

# Entorno de ejecución: local | test | staging | production
DETECTAR_ENV=local

# Versión de las reglas de clasificación (formato vN)
DETECTAR_RULES_VERSION=v1

# Ruta del archivo SQLite. Si se deja sin definir se usa una ruta fuera del repositorio:
#   Windows: %LOCALAPPDATA%\hack30x\detectar\detectar.db
#   Linux/macOS: $XDG_DATA_HOME/hack30x/detectar/detectar.db (o ~/.local/share/...)
# Evitar rutas dentro de OneDrive u otras carpetas sincronizadas.
# DETECTAR_DB_PATH=C:\datos\hack30x\detectar.db

# Cliente HTTP compartido por los conectores (todavía no hay conectores reales)
DETECTAR_HTTP_CONNECT_TIMEOUT_SECONDS=5
DETECTAR_HTTP_READ_TIMEOUT_SECONDS=15
# Reintentos por solicitud ante timeouts, 429 o 5xx (0 a 3)
DETECTAR_HTTP_MAX_RETRIES=2
# Contacto para el User-Agent (correo o URL del proyecto). Obligatorio antes de usar Wikimedia.
# DETECTAR_HTTP_CONTACT=
# Tiempo máximo de cada conector dentro de una recolección, en segundos
DETECTAR_CONNECTOR_TIMEOUT_SECONDS=60

# Token administrativo para POST /api/detectar/recolecciones (mínimo 32 caracteres).
# No tiene valor por defecto: si no se define, el endpoint responde 403.
# Generarlo localmente, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# y definirlo solo en el entorno de la sesión, nunca en un archivo versionado.
# DETECTAR_ADMIN_TOKEN=

# Países permitidos (ISO 3166-1 alfa-2, JSON) y máximo por solicitud
# DETECTAR_COUNTRIES=["CO","MX","AR","CL","PE","EC","VE","US"]
DETECTAR_MAX_COUNTRIES_PER_REQUEST=8

# Google Trends RSS: on | off (sin credenciales)
DETECTAR_GTR_MODE=on

# Wikimedia Pageviews: off por defecto. Para habilitarlo hacen falta las dos cosas:
#   DETECTAR_WIKIMEDIA_MODE=on  y  DETECTAR_HTTP_CONTACT=<correo o URL real del equipo>
# (la política de Wikimedia exige un User-Agent con contacto; no inventar uno).
DETECTAR_WIKIMEDIA_MODE=off
# Ediciones permitidas (dominios), en JSON
# DETECTAR_WIKIMEDIA_PROJECTS=["es.wikipedia.org"]
DETECTAR_WIKIMEDIA_MAX_DAYS=90
DETECTAR_WIKIMEDIA_MAX_ARTICLES=20

# GDELT DOC 2.0: off por defecto. Sin credenciales. Sus términos exigen citar a GDELT
# con un enlace a https://www.gdeltproject.org/ al usar o mostrar los datos.
DETECTAR_GDELT_MODE=off
# Solicitudes por recolección (términos x países de medios) y espera entre solicitudes
DETECTAR_GDELT_MAX_REQUESTS=5
DETECTAR_GDELT_MIN_INTERVAL_SECONDS=5

# Frecuencia de los agentes en minutos (JSON), de 15 minutos a 7 días. Vacío = solo manual.
# DETECTAR_AGENT_SCHEDULES={"trend_hunter": 240, "supervisor": 480}

# Programador periódico (E11). Apagado por defecto. Además de activarlo, el ciclo de vida de
# la app compartida (main.py) debe usar detectar_scheduler_lifespan() (integración pendiente).
DETECTAR_SCHEDULER_ENABLED=false
DETECTAR_SCHEDULER_TICK_SECONDS=60
# data_mode de cada agente programado (obligatorio; sin él el agente no se programa)
# DETECTAR_SCHEDULER_AGENT_MODES={"trend_hunter": "real", "supervisor": "real"}
# Fuentes que recolecta trend_hunter programado (solo google_trends_rss). Vacío: no recolecta.
# DETECTAR_SCHEDULER_TREND_HUNTER_SOURCES=["google_trends_rss"]
# Antigüedad mínima (s) para cerrar como abandonada una ejecución pending/running que no
# esté activa en este proceso. Al menos el doble del tiempo máximo de tarea (300 s).
DETECTAR_AGENT_ABANDON_AFTER_SECONDS=3600
